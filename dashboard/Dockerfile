FROM node:20-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json* pnpm-lock.yaml* bun.lock* ./
RUN npm install --legacy-peer-deps

COPY . .

ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
ARG NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
ARG NEXT_PUBLIC_SENTRY_DISABLED=true
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_SIGN_IN_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_URL
ENV NEXT_PUBLIC_SENTRY_DISABLED=true

RUN npm run build
RUN chown -R node:node /app

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

USER node

CMD ["npm", "run", "start", "--", "-p", "3001"]
