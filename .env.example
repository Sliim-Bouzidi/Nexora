# Copy this file to .env.local and fill in real values.
# In production these are injected via the Kubernetes Secret created from
# k8s/02-secrets.yaml.template, not from this file.

# Postgres connection used by the landing app's articles API
DATABASE_URL="postgresql://nexora:CHANGE_ME@localhost:5432/nexora_cms"

# Clerk authentication (dashboard app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="CHANGE_ME_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="CHANGE_ME_CLERK_SECRET_KEY"

# Clerk redirect routing (dashboard app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard/overview"
